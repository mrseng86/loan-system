# =============================================================================
# Hotel comparison app - environment variables
# =============================================================================
# Copy to .env.local and fill in real keys to enable live data.
# Any connector without credentials will fall back to mock data.

# --- Hotel platforms ---------------------------------------------------------

# Booking.com Affiliate Partner API (https://developers.booking.com/)
BOOKING_AFFILIATE_ID=
BOOKING_API_KEY=

# Agoda Partner API (https://partners.agoda.com/)
AGODA_SITE_ID=
AGODA_API_KEY=

# Expedia Rapid API / EPS (https://developers.expediagroup.com/)
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=

# Trip.com Open Platform (https://open.trip.com/)
TRIP_APP_KEY=
TRIP_APP_SECRET=

# --- Review sources ---------------------------------------------------------

# YouTube Data API v3
YOUTUBE_API_KEY=

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hotel-comparison-app/0.1

# X (Twitter) API v2
TWITTER_BEARER_TOKEN=

# TripAdvisor Content API
TRIPADVISOR_API_KEY=

# Xiaohongshu / Weibo: no official public API - left as scraping stubs.
